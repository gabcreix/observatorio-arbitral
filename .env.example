# Cadena de conexión de Neon (D29). Sin fichero de secretos real en el repo (bloque 5, §3.2).
# La usa el scraper (scraper/db.py).
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/observatorio?sslmode=require

# Los mismos datos de arriba, desglosados — los usa dbt (dbt/profiles.yml),
# que no entiende una cadena de conexión única. La consola de Neon los
# muestra por separado en "Connection Details".
PGHOST=ep-xxxx.region.aws.neon.tech
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=observatorio
PGSSLMODE=require
